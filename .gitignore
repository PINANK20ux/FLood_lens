# ==========================================
# FloodLens Root .gitignore
# ==========================================

# Environment variables & credentials (NEVER commit secrets)
.env
.env.*
*.env
*.env.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Node & Frontend dependencies & build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
build/
.vite/
frontend/.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.oxlint_cache/

# Python & Backend virtualenvs & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.egg

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
backend/*.db
backend/*.sqlite3

# ML test outputs & training runs
test_results/
backend/test_results/
runs/
checkpoints/
*.pt.backup
yolov8*.pt
backend/app/weights/yolov8*.pt

# Dynamic snapshot uploads & test captures
backend/app/static/snapshots/*.jpg
!backend/app/static/snapshots/.gitkeep

# Operating System & IDE metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln

# Temporary directories and logs
logs/
*.log
tmp/
temp/
scratch/
